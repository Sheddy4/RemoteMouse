<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep"
    android:padding="12dp">

    <!-- Заголовок + статус -->
    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_panel"
        android:layout_marginBottom="8dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_status" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Отключено"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAutoFind"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/bg_deep"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:text="⟲ Найти ПК" />
    </LinearLayout>

    <!-- Ручное подключение (запасной вариант) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/etIp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@drawable/bg_edittext"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:hint="IP ПК (вручную)"
            android:textSize="13sp"
            android:inputType="text" />

        <EditText
            android:id="@+id/etPort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_edittext"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:hint="Порт"
            android:text="5555"
            android:textSize="13sp"
            android:inputType="number" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/cyan_primary"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:text="Connect" />
    </LinearLayout>

    <!-- Вкладки-группы функций -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView android:id="@+id/tabMouse" style="@style/TabButton" android:layout_width="86dp" android:text="Мышь" android:drawableTop="@drawable/ic_tab_mouse" android:drawablePadding="2dp" />
            <TextView android:id="@+id/tabApps" style="@style/TabButton" android:layout_width="86dp" android:text="Приложения" android:drawableTop="@drawable/ic_tab_apps" android:drawablePadding="2dp" android:layout_marginStart="4dp" />
            <TextView android:id="@+id/tabBrowser" style="@style/TabButton" android:layout_width="86dp" android:text="Браузер" android:drawableTop="@drawable/ic_tab_browser" android:drawablePadding="2dp" android:layout_marginStart="4dp" />
            <TextView android:id="@+id/tabKeyboard" style="@style/TabButton" android:layout_width="86dp" android:text="Клавиатура" android:drawableTop="@drawable/ic_tab_keyboard" android:drawablePadding="2dp" android:layout_marginStart="4dp" />
            <TextView android:id="@+id/tabMedia" style="@style/TabButton" android:layout_width="86dp" android:text="Медиа" android:drawableTop="@drawable/ic_tab_media" android:drawablePadding="2dp" android:layout_marginStart="4dp" />
            <TextView android:id="@+id/tabSystem" style="@style/TabButton" android:layout_width="86dp" android:text="Система" android:drawableTop="@drawable/ic_tab_system" android:drawablePadding="2dp" android:layout_marginStart="4dp" />
            <TextView android:id="@+id/tabSettings" style="@style/TabButton" android:layout_width="86dp" android:text="Настройки" android:drawableTop="@drawable/ic_tab_settings" android:drawablePadding="2dp" android:layout_marginStart="4dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Содержимое выбранной вкладки -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <!-- МЫШЬ: тачпад + скролл + кнопки, теперь отдельной вкладкой на весь экран -->
        <LinearLayout
            android:id="@+id/pageMouse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/touchpadRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/touchpad"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_touchpad" />

                <View
                    android:id="@+id/scrollTrack"
                    android:layout_width="84dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_scrollbar_track" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonRow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnLeftClick"
                    style="@style/HudButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Левая" />

                <Button
                    android:id="@+id/btnDrag"
                    style="@style/HudButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Зажать" />

                <Button
                    android:id="@+id/btnRightClick"
                    style="@style/HudButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Правая" />
            </LinearLayout>
        </LinearLayout>

        <!-- ПРИЛОЖЕНИЯ -->
        <ScrollView
            android:id="@+id/pageApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/SectionLabel" android:text="БЫСТРЫЙ ЗАПУСК" />
                <LinearLayout
                    android:id="@+id/launcherListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp" />
                <Button
                    android:id="@+id/btnAddLauncher"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_button"
                    android:textColor="@color/cyan_primary"
                    android:textAllCaps="false"
                    android:text="+ Добавить программу" />

                <TextView style="@style/SectionLabel" android:text="ОТКРЫТЫЕ ОКНА" android:layout_marginTop="20dp" />
                <Button
                    android:id="@+id/btnRefreshApps"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_button"
                    android:textColor="@color/cyan_primary"
                    android:textAllCaps="false"
                    android:text="↻ Обновить список окон" />

                <LinearLayout
                    android:id="@+id/appsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </ScrollView>

        <!-- БРАУЗЕР -->
        <ScrollView
            android:id="@+id/pageBrowser"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/SectionLabel" android:text="НАВИГАЦИЯ" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:layout_marginTop="6dp">
                    <Button android:id="@+id/btnBrowserBack" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:text="◀ Назад" />
                    <Button android:id="@+id/btnBrowserForward" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Вперёд ▶" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:layout_marginTop="4dp">
                    <Button android:id="@+id/btnBrowserRefresh" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:text="↻ Обновить" />
                    <Button android:id="@+id/btnBrowserHome" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="⌂ Домой" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:layout_marginTop="4dp">
                    <Button android:id="@+id/btnBrowserNewTab" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:text="+ Вкладка" />
                    <Button android:id="@+id/btnBrowserCloseTab" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="✕ Закрыть вкладку" />
                </LinearLayout>

                <TextView style="@style/SectionLabel" android:text="МАСШТАБ" android:layout_marginTop="16dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:layout_marginTop="6dp">
                    <Button android:id="@+id/btnBrowserZoomOut" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:text="－" />
                    <Button android:id="@+id/btnBrowserZoomReset" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="100%" />
                    <Button android:id="@+id/btnBrowserZoomIn" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="＋" />
                </LinearLayout>

                <TextView style="@style/SectionLabel" android:text="ЗАКЛАДКИ" android:layout_marginTop="20dp" />
                <LinearLayout
                    android:id="@+id/bookmarksListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp" />
                <Button
                    android:id="@+id/btnAddBookmark"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_button"
                    android:textColor="@color/cyan_primary"
                    android:textAllCaps="false"
                    android:text="+ Добавить закладку" />
            </LinearLayout>
        </ScrollView>

        <!-- КЛАВИАТУРА -->
        <ScrollView
            android:id="@+id/pageKeyboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/etKeyboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:hint="Печатай - текст летит на ПК сразу"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:inputType="text" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <Button android:id="@+id/btnKeyEnter" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:text="Enter" />
                    <Button android:id="@+id/btnKeyBackspace" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="⌫" />
                    <Button android:id="@+id/btnKeySpace" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Space" />
                    <Button android:id="@+id/btnClearKeyboard" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Очистить" />
                </LinearLayout>

                <TextView style="@style/SectionLabel" android:text="ГОРЯЧИЕ КЛАВИШИ" android:layout_marginTop="16dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:orientation="horizontal" android:layout_marginTop="6dp">
                    <Button android:id="@+id/btnHkCopy" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:text="Copy" />
                    <Button android:id="@+id/btnHkPaste" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Paste" />
                    <Button android:id="@+id/btnHkCut" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Cut" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:orientation="horizontal" android:layout_marginTop="4dp">
                    <Button android:id="@+id/btnHkUndo" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:text="Undo" />
                    <Button android:id="@+id/btnHkRedo" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Redo" />
                    <Button android:id="@+id/btnHkSave" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Save" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="16dp">
                    <Button android:id="@+id/btnHkAltTab" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:text="Alt+Tab" />
                    <Button android:id="@+id/btnHkWinD" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Рабочий стол" />
                    <Button android:id="@+id/btnHkAltF4" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Alt+F4" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- МЕДИА -->
        <ScrollView
            android:id="@+id/pageMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <!-- Карточка управления -->
                <LinearLayout
                    android:id="@+id/mediaCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_panel"
                    android:padding="28dp">

                    <!-- Prev / Play-Pause / Next -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnMediaPrev"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon_circle"
                            android:textColor="@color/text_primary"
                            android:textAllCaps="false"
                            android:textSize="20sp"
                            android:text="⏮" />

                        <Button
                            android:id="@+id/btnMediaPlayPause"
                            android:layout_width="92dp"
                            android:layout_height="92dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:background="@drawable/bg_button_primary"
                            android:textColor="@color/bg_deep"
                            android:textAllCaps="false"
                            android:textSize="30sp"
                            android:text="⏯" />

                        <Button
                            android:id="@+id/btnMediaNext"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon_circle"
                            android:textColor="@color/text_primary"
                            android:textAllCaps="false"
                            android:textSize="20sp"
                            android:text="⏭" />
                    </LinearLayout>

                    <!-- Громкость -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="32dp">

                        <Button
                            android:id="@+id/btnVolDown"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_circle"
                            android:textColor="@color/cyan_primary"
                            android:textAllCaps="false"
                            android:textSize="18sp"
                            android:text="－" />

                        <Button
                            android:id="@+id/btnMute"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/bg_icon_circle"
                            android:textColor="@color/text_primary"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:text="🔇" />

                        <Button
                            android:id="@+id/btnVolUp"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_circle"
                            android:textColor="@color/cyan_primary"
                            android:textAllCaps="false"
                            android:textSize="18sp"
                            android:text="＋" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnMediaStop"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="24dp"
                        style="@style/HudButton"
                        android:text="■  Стоп" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- СИСТЕМА: буфер обмена + питание -->
        <ScrollView
            android:id="@+id/pageSystem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/SectionLabel" android:text="БУФЕР ОБМЕНА" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginTop="6dp">
                    <Button android:id="@+id/btnClipboardGet" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:text="⇩ Забрать с ПК" />
                    <Button android:id="@+id/btnClipboardSend" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="⇧ Отправить на ПК" />
                </LinearLayout>

                <TextView style="@style/SectionLabel" android:text="ПИТАНИЕ" android:layout_marginTop="20dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginTop="6dp">
                    <Button android:id="@+id/btnSleep" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:text="Сон" />
                    <Button android:id="@+id/btnRestart" style="@style/HudButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Рестарт" />
                    <Button
                        android:id="@+id/btnShutdown"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_danger"
                        android:textColor="@color/danger"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:text="Выкл" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- НАСТРОЙКИ -->
        <ScrollView
            android:id="@+id/pageSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/SectionLabel" android:text="ЧУВСТВИТЕЛЬНОСТЬ ТАЧПАДА" />
                <TextView
                    android:id="@+id/tvSensitivityValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="x3.0"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <SeekBar
                    android:id="@+id/seekSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="55"
                    android:progress="20" />

                <TextView style="@style/SectionLabel" android:text="СКОРОСТЬ СКРОЛЛА" android:layout_marginTop="18dp" />
                <TextView
                    android:id="@+id/tvScrollSpeedValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="x4.0"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <SeekBar
                    android:id="@+id/seekScrollSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="55"
                    android:progress="30" />

                <TextView style="@style/SectionLabel" android:text="ЧУВСТВИТЕЛЬНОСТЬ ГИРОСКОПА" android:layout_marginTop="18dp" />
                <TextView
                    android:id="@+id/tvGyroSensitivityValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="900"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <SeekBar
                    android:id="@+id/seekGyroSensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="190"
                    android:progress="80" />

                <LinearLayout
                    android:id="@+id/leftHandedPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_panel"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Режим для левшей (зеркалит тачпад)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/switchLeftHanded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/gyroPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_panel"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Gyro-mouse (наклон телефона двигает курсор)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/switchGyro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView style="@style/SectionLabel" android:text="ТЕМА ОФОРМЛЕНИЯ" android:layout_marginTop="20dp" />
                <LinearLayout
                    android:id="@+id/themeSwatchesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <EditText
                        android:id="@+id/etCustomColor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edittext"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:hint="#RRGGBB - свой цвет темы"
                        android:inputType="text" />

                    <Button
                        android:id="@+id/btnApplyCustomColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button"
                        android:textColor="@color/cyan_primary"
                        android:textAllCaps="false"
                        android:text="Применить" />
                </LinearLayout>

                <TextView style="@style/SectionLabel" android:text="ЦВЕТ КНОПОК (отдельно от темы)" android:layout_marginTop="20dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp">

                    <EditText
                        android:id="@+id/etButtonColor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edittext"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:hint="#RRGGBB - цвет кнопок"
                        android:inputType="text" />

                    <Button
                        android:id="@+id/btnApplyButtonColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button"
                        android:textColor="@color/cyan_primary"
                        android:textAllCaps="false"
                        android:text="Применить" />

                    <Button
                        android:id="@+id/btnResetButtonColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button"
                        android:textColor="@color/text_secondary"
                        android:textAllCaps="false"
                        android:text="Сброс" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</LinearLayout>
