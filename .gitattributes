# Auto detect text files and perform LF normalization
* text=auto

# Force LF for shell scripts (important for gradlew on Linux CI)
*.sh text eol=lf
gradlew text eol=lf

# Force CRLF for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - no conversion
*.apk binary
*.jar binary
*.keystore binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
